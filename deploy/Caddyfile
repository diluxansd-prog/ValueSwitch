# /etc/caddy/Caddyfile — TLS certificates are obtained and renewed
# automatically by Caddy. Point the domain's A record here first.
www.valueswitch.co.uk, valueswitch.co.uk {
	encode zstd gzip

	# Next writes immutable, content-hashed assets here.
	@static path /_next/static/* /images/* /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/valueswitch.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
